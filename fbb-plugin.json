{
  "schema_version": 1,
  "name": "fbb-plugin-space-guidance",
  "vendor": "F-BB Community",
  "version": "1.0.0",
  "description": "Autonomous Space Guidance and Docking Challenge Plugin for FPGA-BoardlessBench",
  "commands": [
    {
      "desc": "Stage 1: Asteroid Pipeline (2D Microgravity Line Tracking)",
      "cmd": "fbb lab {PLUGIN_DIR}/scenario/01_asteroid_pipeline"
    },
    {
      "desc": "Stage 2: Orbital Tether Climber (1D String Vibration Suppression)",
      "cmd": "fbb lab {PLUGIN_DIR}/scenario/02_tether_climber"
    },
    {
      "desc": "Stage 3: ISS Truss Inspector (3D Curved Rail Traverse)",
      "cmd": "fbb lab {PLUGIN_DIR}/scenario/03_iss_truss"
    },
    {
      "desc": "Stage 4: Deep Space Laser Docking (6-DoF Zero Friction Alignment)",
      "cmd": "fbb lab {PLUGIN_DIR}/scenario/04_laser_docking"
    },
    {
      "desc": "Stage EX: Panic Control (Debris Impact 3-Axis Autonomous Recovery)",
      "cmd": "fbb lab {PLUGIN_DIR}/scenario/05_panic_control"
    }
  ],
  "peripherals": [
    {
      "bus": "axil",
      "compatible": "fbb,space-guidance",
      "binary": "bin/space_guidance_daemon",
      "default_args": [
        "--base",
        "0x43C00000"
      ],
      "ui_widget": {
        "title": "Space Guidance Cockpit"
      }
    }
  ],
  "panes": [
    {
      "id": "sg-orbit-viewer",
      "title": "SG 3D Cyber Orbit Viewer",
      "entry": "panes/sg-orbit-viewer/index.js"
    },
    {
      "id": "sg-telemetry-gauge",
      "title": "SG Telemetry & C&W",
      "entry": "panes/sg-telemetry-gauge/index.js"
    },
    {
      "id": "sg-chaos-fdir",
      "title": "SG Chaos FDIR & Scorecard",
      "entry": "panes/sg-chaos-fdir/index.js"
    }
  ]
}
